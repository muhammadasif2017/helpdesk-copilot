# LLM backend — any OpenAI-compatible endpoint works.
#
# Option A: Groq free tier (fast, recommended for demos)
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=llama-3.1-8b-instant
#
# Option B: Ollama running locally (fully offline)
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen2.5:3b
#
# Use a plain instruct model, not a reasoning model (Qwen3, DeepSeek-R1):
# reasoning tokens add ~a minute per answer on CPU-only machines.

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# Model used by the eval judge (tests only). Grading entailment is harder than
# answering, so this should be at least as strong as LLM_MODEL. Defaults to
# LLM_MODEL if unset. See the eval section of the README for measured accuracy.
JUDGE_MODEL=

# Tracing (optional). Leave blank and the app runs with tracing off.
# Start the stack with:
#   docker compose -f docker-compose.langfuse.yml up -d
# It bootstraps a project with these local-only dev keys; UI at localhost:3100.
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
